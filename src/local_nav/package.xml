<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>local_nav</name>
  <version>0.1.0</version>
  <description>Local (map-free) obstacle-avoidance navigation: a rolling-window
    costmap fed by obstacle_detector's output, an MPPI controller configured
    with an Ackermann motion model, and a carrot-path publisher supplying the
    naive straight-ahead reference path MPPI needs to deviate from.</description>
  <maintainer email="n.divagar18@gmail.com">divagar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>slam_toolbox</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>dwb_core</depend>
  <depend>dwb_critics</depend>
  <depend>teb_local_planner</depend>
  <depend>costmap_converter</depend>
  <depend>nav2_planner</depend>
  <depend>nav2_navfn_planner</depend>
  <depend>nav2_smac_planner</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>ground_segmentation_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>umrr_ros2_msgs</depend>

  <!-- Lane-following mode (carrot_path_publisher._build_lane_path):
       medial-axis skeleton of the local costmap's free space, graph
       search along it. python3-scipy already ubiquitous in ROS installs
       (used for distance/KD-tree queries here); python3-skimage
       (skeletonize) and python3-networkx (shortest_path) are the two
       actually-new dependencies this mode adds. -->
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-skimage</exec_depend>
  <exec_depend>python3-networkx</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
