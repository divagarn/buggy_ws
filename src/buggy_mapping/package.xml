<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>buggy_mapping</name>
  <version>0.1.0</version>
  <description>SLAM mapping (drive the world once, save a map) and map-based
    closed-loop navigation (localize against that saved map, set a goal
    anywhere in it) - a separate capability from local_nav's map-free
    rolling-costmap navigation, built on top of it rather than replacing
    it. See launch/mapping.launch.py and launch/closed_loop_navigate.launch.py
    for the two phases.</description>
  <maintainer email="n.divagar18@gmail.com">divagar</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>slam_toolbox</depend>
  <depend>pointcloud_to_laserscan</depend>
  <depend>teleop_twist_keyboard</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>local_nav</depend>
  <depend>ground_segmentation</depend>
  <depend>buggy_description</depend>
  <depend>velodyne_driver</depend>
  <depend>velodyne_pointcloud</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
